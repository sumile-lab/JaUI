{
  "name": "@jaui/core",
  "version": "0.0.0",
  "private": true,
  "description": "JaUI reference implementation using Lit and TypeScript",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
